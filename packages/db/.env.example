# Copy to packages/db/.env for a local run. These are the docker-compose credentials from
# docker-compose.yml at the repository root, and they are development values, not secrets.
# Nothing here reaches any environment but your own machine.
#
# The tests never write into this database. Each test run creates its own
# `orderflow_test_<run>` on the same server and drops it afterwards, because the ledger is
# append-only and rows written by a test would outlive it. This URL only tells the tests
# which server to create that database on.
DATABASE_URL="postgresql://orderflow:orderflow@localhost:55432/orderflow"
