            }
          }
        },
        "security": [{ "bearer": [] }],
        "summary": "The authenticated caller's balances, holds and buying power",
        "tags": ["Portfolio"]
      }
    },
    "/ledger": {
      "get": {
        "description": "Keyset-paginated, sorted by (createdAt desc, id desc), at most 200 entries a page. createdAt is when the entry was written, and the time filter applies to it: for a seeded trade that is the seed-run time, not the trade time. fillId leads from a TRADE entry to its trade.",
        "operationId": "LedgerController_ledger",
        "parameters": [
          {
            "name": "currency",
            "required": false,
            "in": "query",
            "schema": { "type": "string", "pattern": "^[A-Z]{3,4}$" }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "schema": { "type": "string", "format": "date-time" },
            "description": "Exclusive, with an offset. At most millisecond precision, from year 1."
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "schema": { "type": "string", "format": "date-time" },
            "description": "Inclusive, with an offset. At most millisecond precision, from year 1."
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "schema": { "type": "string" },
            "description": "The nextCursor of a previous page."
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/LedgerPage" } }
            }
          },
          "400": {
            "description": "The request failed validation.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "401": {
            "description": "The bearer token is missing or invalid.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "403": {
            "description": "The token is valid, but its subject has no account.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "429": {
            "description": "Over the rate limit. See the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the limit resets.",
                "schema": { "type": "integer" }
              }
            },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "500": {
            "description": "Something went wrong. The body carries no detail.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "503": {
            "description": "A dependency is unavailable.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          }
        },
        "security": [{ "bearer": [] }],
        "summary": "The authenticated caller's own ledger entries",
        "tags": ["Ledger"]
      }
    },
    "/trades": {
      "get": {
        "description": "Keyset-paginated, sorted by (filledAt desc, fillId desc, side asc), at most 200 rows a page. filledAt is the trade time, and the time filter applies to it. A fill whose two orders are both the caller's gives a BUY row and a SELL row. price and quantity are as stored. fillId leads to the TRADE entries on GET /ledger, which carry the exact amounts.",
        "operationId": "TradesController_trades",
        "parameters": [
          {
            "name": "instrument",
            "required": false,
            "in": "query",
            "schema": { "type": "string", "pattern": "^[A-Z]{3,4}-[A-Z]{3,4}$" },
            "description": "An instrument symbol, such as BTC-USD. One with no instrument is a 400."
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "schema": { "type": "string", "format": "date-time" },
            "description": "Exclusive, with an offset. At most millisecond precision, from year 1."
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "schema": { "type": "string", "format": "date-time" },
            "description": "Inclusive, with an offset. At most millisecond precision, from year 1."
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "schema": { "type": "string" },
            "description": "The nextCursor of a previous page."
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/TradesPage" } }
            }
          },
          "400": {
            "description": "The request failed validation.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "401": {
            "description": "The bearer token is missing or invalid.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "403": {
            "description": "The token is valid, but its subject has no account.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "429": {
            "description": "Over the rate limit. See the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the limit resets.",
                "schema": { "type": "integer" }
              }
            },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "500": {
            "description": "Something went wrong. The body carries no detail.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "503": {
            "description": "A dependency is unavailable.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          }
        },
        "security": [{ "bearer": [] }],
        "summary": "The authenticated caller's own fills, one row per side the caller was on",
        "tags": ["Trades"]
      }
    },
    "/candles": {
      "get": {
        "description": "Market data, with no account data. Returns the candles whose openTime is in [from, to), oldest first, with OHLCV values as stored. The window may span at most 1000 interval periods, a partial period counting as one, so at most 1000 candles come back; a longer window is a 400 at query.to. There is no pagination.",
        "operationId": "CandlesController_candles",
        "parameters": [
          {
            "name": "to",
            "required": true,
            "in": "query",
            "schema": { "type": "string", "format": "date-time" },
            "description": "Exclusive, with an offset, later than from. At most millisecond precision."
          },
          {
            "name": "from",
            "required": true,
            "in": "query",
            "schema": { "type": "string", "format": "date-time" },
            "description": "Inclusive, with an offset. At most millisecond precision, from year 1."
          },
          {
            "name": "interval",
            "required": true,
            "in": "query",
            "schema": { "type": "string", "enum": ["1m", "1h", "1d"] }
          },
          {
            "name": "instrument",
            "required": true,
            "in": "query",
            "schema": { "type": "string", "pattern": "^[A-Z]{3,4}-[A-Z]{3,4}$" },
            "description": "An instrument symbol, such as BTC-USD. One with no instrument is a 400."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CandlesResponse" } }
            }
          },
          "400": {
            "description": "The request failed validation.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "401": {
            "description": "The bearer token is missing or invalid.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "403": {
            "description": "The token is valid, but its subject has no account.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "429": {
            "description": "Over the rate limit. See the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the limit resets.",
                "schema": { "type": "integer" }
              }
            },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "500": {
            "description": "Something went wrong. The body carries no detail.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "503": {
            "description": "A dependency is unavailable.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          }
        },
        "security": [{ "bearer": [] }],
        "summary": "One instrument's stored candles at one interval, in a time window",
        "tags": ["Candles"]
      }
    }
  },
  "info": {
    "title": "OrderFlow API",
    "description": "Every failure uses the ErrorResponse shape. All money is a Money string.",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": { "bearer": { "scheme": "bearer", "bearerFormat": "JWT", "type": "http" } },
    "schemas": {
      "CandlesResponse": {
        "type": "object",
        "properties": {
          "instrument": { "type": "string" },
          "interval": { "type": "string", "enum": ["1m", "1h", "1d"] },
          "candles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "openTime": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "open": { "type": "string", "pattern": "^-?\\d{1,20}(\\.\\d{1,18})?$" },
                "high": { "type": "string", "pattern": "^-?\\d{1,20}(\\.\\d{1,18})?$" },
                "low": { "type": "string", "pattern": "^-?\\d{1,20}(\\.\\d{1,18})?$" },
                "close": { "type": "string", "pattern": "^-?\\d{1,20}(\\.\\d{1,18})?$" },
                "volume": { "type": "string", "pattern": "^-?\\d{1,20}(\\.\\d{1,18})?$" }
              },
              "required": ["openTime", "open", "high", "low", "close", "volume"],
              "additionalProperties": false
            }
          }
        },
        "required": ["instrument", "interval", "candles"],
        "additionalProperties": false,
        "description": "One window of an instrument's stored candles at one interval, oldest first, at most 1,000. OHLCV values are Money strings, as stored."
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "BAD_REQUEST",
              "VALIDATION_FAILED",
              "INVALID_CURRENCY",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "UNKNOWN_SUBJECT",
              "TREASURY_HAS_NO_BUYING_POWER",
              "NOT_FOUND",
              "ACCOUNT_NOT_FOUND",
              "REQUEST_REJECTED",
              "RATE_LIMITED",
              "INTERNAL_ERROR",
              "AUTH_UNAVAILABLE",
              "NOT_READY"
            ]
          },
          "message": { "type": "string" },
          "correlationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "path": { "type": "string" }, "message": { "type": "string" } },
              "required": ["path", "message"],
              "additionalProperties": false
            }
          }
        },
        "required": ["code", "message", "correlationId"],
        "additionalProperties": false,
        "description": "The shape of every failure."
      },
      "LedgerPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "transactionId": { "type": "string" },
                "type": { "type": "string", "enum": ["DEPOSIT", "TRADE", "CORRECTION"] },
                "currency": { "type": "string" },
                "amount": { "type": "string", "pattern": "^-?\\d{1,20}(\\.\\d{1,18})?$" },
                "createdAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "fillId": { "nullable": true, "type": "string" }
              },
              "required": [
                "id",
                "transactionId",
                "type",
                "currency",
                "amount",
                "createdAt",
                "fillId"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": { "nullable": true, "type": "string" }
        },
        "required": ["items", "nextCursor"],
        "additionalProperties": false,
        "description": "One page of the caller's ledger entries, newest first. nextCursor is null on the last page."
      },
      "LivenessResponse": {
        "type": "object",
        "properties": { "status": { "type": "string", "enum": ["ok"] } },
        "required": ["status"],
        "additionalProperties": false,
        "description": "The process is up."
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "accountId": { "type": "string" },
          "type": { "type": "string", "enum": ["USER", "BOT", "TREASURY"] },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": ["accountId", "type", "createdAt"],
        "additionalProperties": false,
        "description": "The authenticated caller's account."
      },
      "Money": {
        "type": "string",
        "pattern": "^-?\\d{1,20}(\\.\\d{1,18})?$",
        "description": "An exact decimal amount as a string, NUMERIC(38, 18). Never a JSON number, so precision survives, and never in exponent notation. It is not rounded to any display scale."
      },
      "PortfolioResponse": {
        "type": "object",
        "properties": {
          "currencies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "currency": { "type": "string" },
                "balance": { "type": "string", "pattern": "^-?\\d{1,20}(\\.\\d{1,18})?$" },
                "held": { "type": "string", "pattern": "^-?\\d{1,20}(\\.\\d{1,18})?$" },
                "buyingPower": { "type": "string", "pattern": "^-?\\d{1,20}(\\.\\d{1,18})?$" }
              },
              "required": ["currency", "balance", "held", "buyingPower"],
              "additionalProperties": false
            }
          }
        },
        "required": ["currencies"],
        "additionalProperties": false,
        "description": "The caller's balance, held amount and buying power in each currency with a non-zero balance, ordered by currency code."
      },
      "ReadinessResponse": {
        "type": "object",
        "properties": { "status": { "type": "string", "enum": ["ready"] } },
        "required": ["status"],
        "additionalProperties": false,
        "description": "The database answered."
      },
      "TradesPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fillId": { "type": "string" },
                "instrument": { "type": "string" },
                "side": { "type": "string", "enum": ["BUY", "SELL"] },
                "price": { "type": "string", "pattern": "^-?\\d{1,20}(\\.\\d{1,18})?$" },
                "quantity": { "type": "string", "pattern": "^-?\\d{1,20}(\\.\\d{1,18})?$" },
                "filledAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                }
              },
              "required": ["fillId", "instrument", "side", "price", "quantity", "filledAt"],
              "additionalProperties": false
            }
          },
          "nextCursor": { "nullable": true, "type": "string" }
        },
        "required": ["items", "nextCursor"],
        "additionalProperties": false,
        "description": "One page of the caller's fills, one row per side the caller was on, newest first. nextCursor is null on the last page."
      }
    }
  }
}
