# Copy to services/api/.env for a local run. These are placeholders: fill the OIDC values in from
# your identity provider, and never commit the result. `.env` stays untracked.
DATABASE_URL="postgresql://orderflow:orderflow@localhost:55432/orderflow"

OIDC_ISSUER="https://issuer.example.invalid/"
OIDC_AUDIENCE="orderflow-api"
OIDC_JWKS_URI="https://issuer.example.invalid/.well-known/jwks.json"

# Optional. The values shown are the defaults.
# OIDC_JWKS_CACHE_TTL_SECONDS=600
# OIDC_JWKS_COOLDOWN_SECONDS=30
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_AUTHENTICATED=120
# RATE_LIMIT_PUBLIC=60
# PORT=3000
