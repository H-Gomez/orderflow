{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "lint": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      // Turbo runs in strict env mode, so a variable not named here never reaches the task.
      // The database tests read DATABASE_URL to find a server and CI to decide whether an
      // absent one is a skip or a failure; without both, CI would set them and Vitest would
      // never see them. Naming them here also puts them in the cache key, so a green run
      // with no database cannot be replayed as a pass for a run that had one.
      "env": ["CI", "DATABASE_URL"]
    },
    "generate": {
      "outputs": ["src/generated/**"]
    }
  }
}
